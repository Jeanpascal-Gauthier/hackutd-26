# Copy to agent/.env and fill in. agent/.env is gitignored; never commit it.

# NVIDIA API catalog key (build.nvidia.com), starts with "nvapi-"
NVIDIA_API_KEY=
# Optional overrides
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Photon (SMS / voice inbound + replies)
PHOTON_API_KEY=
PHOTON_API_SECRET=
PHOTON_PHONE_NUMBER=
PHOTON_WEBHOOK_SECRET=
