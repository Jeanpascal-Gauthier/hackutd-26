{
  "name": "@firewatch/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/*/*.test.ts\"",
    "demo:cbre": "tsx src/mock/cbreDemo.ts",
    "verify": "tsx src/mock/verify.ts",
    "verify:live": "tsx src/live/verify.ts"
  },
  "dependencies": {
    "@firewatch/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
