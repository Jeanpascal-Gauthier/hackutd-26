# Single env file for the whole repo.
# Copy to .env at the repo root and fill in. Never commit .env.
# Every workspace script loads ../.env (the repo root), so there is no
# per-folder .env.

# --- agent/: NVIDIA (build.nvidia.com), key starts with "nvapi-" ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- agent/: Photon line (npm run photon -w agent; npm run demo starts it when set) ---
# Photon 2.0, https://app.beta.photon.codes: Settings -> Project id (pho_prj_...);
#   API keys -> New API key (pho_sk_..., shown once). Polls for messages: no webhook needed.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# --- agent/: QR report form (optional; defaults shown) ---
# FORM_PORT=8090
# FORM_PUBLIC_URL=      # URL the QR encodes, e.g. a tunnel URL; default http://<LAN IP>:8090/

# --- server/ (all optional; defaults shown) ---
# PORT=8080
# TICK_MS=2000
# MOCK=1
# AUTOPLAY=1
# VOICE_TOKEN=          # set to any long random string to enable POST /voice/report (phone calls)
# AGENT_TIMEOUT_MS=20000  # use ~12000 with voice calls, below the ElevenLabs tool timeout
