<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components. The :dark
  styles apply because iwsdk.config.json prefers the dark color scheme.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 420px;
  }

  .panel-content {
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    padding-right: 22px;
    padding-bottom: 14px;
    padding-left: 22px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 16px;
    font-weight: 700;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 20px;
    line-height: 1.25;
  }

  .body:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: flex-start;
    min-height: 46px;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 10px;
  }

  .button-label {
    font-size: 20px;
    font-weight: 700;
  }

  .setup-status {
    width: 376px;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 18px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">FIREWATCH SETUP</div>
    <div class="heading">Your command room</div>
    <div class="body">Face forward, then center the room.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <Button id="center-room-button" class="button">
    <ButtonLabel class="button-label">Center room here</ButtonLabel>
  </Button>
  <Button id="bring-building-button" class="button">
    <ButtonLabel class="button-label">Bring building closer</ButtonLabel>
  </Button>
  <div id="setup-status" class="body setup-status">Pinch the building to grab. Use both hands to zoom.</div>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to browser</ButtonLabel>
  </Button>
</Panel>
