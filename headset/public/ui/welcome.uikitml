<!--
  Room setup panel, mounted on the right wall facet beside "Resources & people".
  Follows the same card pattern as the other wall panels: heading, status line,
  full-width actions. Panel, Button, ButtonIcon and ButtonLabel come from the
  bundled Horizon kit; RectangleGoggles and LogIn are Lucide icons. The :dark
  styles apply because iwsdk.config.json prefers the dark color scheme.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 360px;
  }

  .panel-content {
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
  }

  .heading {
    color: #1c1d20;
    font-size: 28px;
    font-weight: 700;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .status {
    color: #49515e;
    font-size: 18px;
    line-height: 1.25;
  }

  .status:dark {
    color: #c3c6cc;
  }

  .action {
    width: 312px;
    min-height: 48px;
    justify-content: center;
  }

  .action-label {
    font-size: 22px;
    font-weight: 700;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <span class="heading">Room setup</span>
    <span id="setup-status" class="status">Face the front desk, then center the room.</span>
    <Button id="xr-button" class="action">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel class="action-label">Enter VR</ButtonLabel>
    </Button>
    <Button id="center-room-button" class="action">
      <ButtonLabel class="action-label">Center room here</ButtonLabel>
    </Button>
    <Button id="bring-building-button" class="action">
      <ButtonLabel class="action-label">Bring building closer</ButtonLabel>
    </Button>
    <span class="heading">Building floors</span>
    <span id="floor-cut-status" class="status">All floors</span>
    <Button id="floor-up-button" class="action"><ButtonLabel class="action-label">Floor up</ButtonLabel></Button>
    <Button id="floor-down-button" class="action"><ButtonLabel class="action-label">Floor down</ButtonLabel></Button>
    <Button id="show-all-floors-button" class="action"><ButtonLabel class="action-label">Show all floors</ButtonLabel></Button>
    <Button id="exit-button" class="action" style="display: none">
      <ButtonIcon>
        <LogIn></LogIn>
      </ButtonIcon>
      <ButtonLabel class="action-label">Exit to browser</ButtonLabel>
    </Button>
  </div>
</Panel>
